<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="main_sub">CHZZK アプリ（または配信を再生しているアプリ）の上に、リアルタイム字幕とチャット翻訳を表示します。</string>
    <string name="btn_start">▶ 翻訳を開始</string>
    <string name="btn_stop_all">■ 停止</string>
    <string name="btn_open_chzzk">CHZZK ↗</string>
    <string name="main_steps">1. 下に無料の Groq キーを貼り付けます。\n2. 開始を押して、許可（他のアプリの上に重ねて表示・画面の録画）を与えます。\n3. CHZZK アプリで配信を開きます。\n4. 浮かんでいる CC ボタン →「チャット範囲」で、枠をチャットの上に動かします。</string>
    <string name="st_ready">準備完了</string>
    <string name="st_running">翻訳中 — CHZZK アプリを開いてください</string>
    <string name="st_pick_one">字幕かチャット翻訳のどちらかをオンにしてください</string>

    <string name="sec_what">翻訳するもの</string>
    <string name="set_subs">音声 → 字幕</string>
    <string name="set_screen_chat">画面のチャット → 自分の言語</string>
    <string name="set_screen_chat_note">選んだ画面の範囲（CC ボタン → チャット範囲）からチャットを読み取ります。画面の画像はこの端末内で読むだけでアップロードしません。認識したチャットの文字だけを翻訳に送ります。</string>

    <string name="sec_keys">API キー</string>
    <string name="set_intro">カード登録不要の無料キーです。この端末にだけ保存され、Groq / NVIDIA にだけ送信されます。</string>
    <string name="set_groq">Groq API キー（必須）</string>
    <string name="set_groq_get">無料の Groq キーを取得 ↗</string>
    <string name="set_nv">NVIDIA API キー（任意 — スラングに強い）</string>
    <string name="set_nv_get">無料の NVIDIA キーを取得 ↗</string>

    <string name="sec_translation">翻訳</string>
    <string name="set_lang">翻訳先の言語</string>
    <string name="set_orig">韓国語の原文も表示</string>
    <string name="set_preset">ステラライブ用語集（内蔵）</string>
    <string name="set_preset_note">メンバー名、ファンネーム、挨拶、ミーム —「翻訳先の言語」に合わせて英語版か日本語版を使います。下に自分で入れた用語が優先されます。</string>
    <string name="set_glossary">名前・用語（1行に1つ、例: 멤버이름 = メンバー名）</string>

    <string name="sec_look">見た目・タイミング</string>
    <string name="set_font">文字の大きさ</string>
    <string name="set_overlay_pos">字幕の高さ（下から）</string>
    <string name="set_pace">Whisper のタイミング</string>
    <string name="pace_allday">一日中（約15秒遅れ、1日約8時間）</string>
    <string name="pace_fast">速め（5〜10秒遅れ、1日3〜5時間）</string>

    <string name="set_privacy">仕組み：開始すると Android が画面の録画の許可を求めます。アプリはこれで配信の音声を聞き、チャット翻訳がオンなら選んだチャット範囲を読み取ります。録画・保存はせず、画面の画像が端末の外に出ることはありません。他のアプリの音も拾うことがあるので、見終わったら止めてください（CC ボタン → 停止、または通知）。</string>

    <string name="menu_subs_on">字幕：オン</string>
    <string name="menu_subs_off">字幕：オフ</string>
    <string name="menu_chat_on">チャット翻訳：オン</string>
    <string name="menu_chat_off">チャット翻訳：オフ</string>
